        {
          "id": "b8ba38e8-f64f-4274-bd8d-6a19a6c56752",
          "name": "Transcribe audio to text",
          "request": {
            "name": "Transcribe audio to text",
            "description": {
              "content": "Transcribes an audio file in an Indian language using the Saaras or Saarika speech-recognition models. Supports auto language detection, word-level timestamps, and speaker diarization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "speech-to-text"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Audio file (WAV, MP3, AAC, AIFF, OGG, OPUS, FLAC, MP4/M4A, AMR, WMA, WebM, PCM). Optimized for 16kHz."
                },
                {
                  "key": "model",
                  "value": "saarika:v2.5",
                  "type": "text",
                  "description": " (This can only be one of saarika:v2.5,saaras:v3)"
                },
                {
                  "key": "language_code",
                  "value": "<string>",
                  "type": "text",
                  "description": "BCP-47 code (e.g. hi-IN) or \"unknown\" for auto-detection."
                },
                {
                  "key": "mode",
                  "value": "<string>",
                  "type": "text",
                  "description": "saaras:v3 only. (This can only be one of transcribe,translate,verbatim,translit,codemix)"
                },
                {
                  "key": "input_audio_codec",
                  "value": "<string>",
                  "type": "text",
                  "description": "Required only for PCM files. (This can only be one of pcm_s16le,pcm_l16,pcm_raw)"
                }
              ]
            }
          },
