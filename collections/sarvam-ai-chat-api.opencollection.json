{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sarvam AI Chat API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-subscription-key",
      "value": "{{api-subscription-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a chat completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sarvam.ai/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a model response for a conversation using Sarvam's Indic LLMs (sarvam-m, sarvam-30b, sarvam-105b). Supports streaming via Server-Sent Events when stream is true, tool use, and reasoning effort."
        }
      ]
    }
  ],
  "bundled": true
}